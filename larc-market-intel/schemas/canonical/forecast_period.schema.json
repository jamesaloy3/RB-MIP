{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcwhinney.internal/schemas/canonical/forecast_period.schema.json",
  "title": "ForecastPeriod",
  "description": "A single quarter or year of forecast/actual operating data. This is the fact table: one row per (publication, market, period). Handles both historical actuals and forward forecasts via is_forecast flag.",
  "type": "object",
  "required": [
    "publication_id",
    "market",
    "year",
    "period_type",
    "is_forecast"
  ],
  "properties": {
    "publication_id": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "market": { "type": "string", "description": "Canonical market name" },
    "year": { "type": "integer", "minimum": 2000, "maximum": 2050 },
    "quarter": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 4,
      "description": "Null for annual rollups."
    },
    "period_type": {
      "type": "string",
      "enum": ["quarterly", "annual"]
    },
    "is_forecast": {
      "type": "boolean",
      "description": "True if this period is in the forecast horizon; false if historical actual."
    },

    "supply": {
      "type": ["number", "null"],
      "description": "Available room nights in the period."
    },
    "supply_growth_pct": {
      "type": ["number", "null"],
      "description": "YoY supply growth, as decimal (0.013 = 1.3%)."
    },
    "demand": {
      "type": ["number", "null"],
      "description": "Occupied room nights."
    },
    "demand_growth_pct": { "type": ["number", "null"] },

    "occupancy": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1.2,
      "description": "Decimal (0.673 = 67.3%). Upper bound 1.2 allows data errors to be caught by validator."
    },
    "occupancy_growth_pct": { "type": ["number", "null"] },

    "adr": {
      "type": ["number", "null"],
      "description": "Average Daily Rate in USD."
    },
    "adr_growth_pct": { "type": ["number", "null"] },

    "revpar": {
      "type": ["number", "null"],
      "description": "Revenue per Available Room in USD."
    },
    "revpar_growth_pct": { "type": ["number", "null"] },

    "revenues": {
      "type": ["number", "null"],
      "description": "Total room revenue USD."
    },

    "wage_growth_pct": { "type": ["number", "null"] },
    "property_tax_growth_pct": { "type": ["number", "null"] },
    "expense_growth_pct": { "type": ["number", "null"] },

    "hotel_ebitda": { "type": ["number", "null"], "description": "USD" },
    "hotel_ebitda_margin": {
      "type": ["number", "null"],
      "description": "Decimal (0.263 = 26.3%)"
    },
    "hotel_ebitda_growth_pct": { "type": ["number", "null"] },
    "hotel_ebitda_margin_change_bps": {
      "type": ["number", "null"],
      "description": "YoY change in margin in basis points."
    },

    "cap_rate": {
      "type": ["number", "null"],
      "description": "Decimal (0.089 = 8.9%)"
    },
    "cap_rate_change_bps": { "type": ["number", "null"] },

    "hotel_value_index_2019": {
      "type": ["number", "null"],
      "description": "Value indexed to 2019 = 100."
    },
    "hotel_value_change_pct": {
      "type": ["number", "null"],
      "description": "YoY % change in value."
    },
    "hotel_value_change_pct_from_2025_base": {
      "type": ["number", "null"],
      "description": "% change vs 2025 as base (LARC report convention)."
    },

    "source_notes": {
      "type": "string",
      "description": "Any provenance notes (e.g., 'LARC quarterly forecast table page 2')."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "period_type": { "const": "quarterly" } } },
      "then": { "required": ["quarter"] }
    },
    {
      "if": { "properties": { "period_type": { "const": "annual" } } },
      "then": { "properties": { "quarter": { "type": "null" } } }
    }
  ]
}
